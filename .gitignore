# Local collection output. Everything is ignored except the exact artifacts that
# have been approved in config/publication_approvals.json, whose SPDX metadata
# and bundled-asset rights were reviewed, and whose isolated runtime result is
# recorded in data/reports/. A re-collection rewrites games/_repos in full, so the
# allowlist is per file: adding an approved artifact means adding two lines here.
games/_repos/*
!games/_repos/Time-dev-alt__Fable-5.1-Games/
games/_repos/Time-dev-alt__Fable-5.1-Games/*
!games/_repos/Time-dev-alt__Fable-5.1-Games/LICENSE
!games/_repos/Time-dev-alt__Fable-5.1-Games/Soccer.html

# Generated Pages artifact
site/data/
site/games/
site/build-manifest.json
site/.nojekyll

data/projects.jsonl
# Verified pre-recreate snapshots written by `build_catalog.py --fresh`
data/backups/
